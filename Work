
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Orbit Chat</title>
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      background: #171821;
      color: #f5f5ff;
      font-family: Arial, sans-serif;
      height: 100vh;
      display: flex;
    }
    aside {
      width: 110px;
      background: #20212c;
      padding: 15px 10px;
    }
    .logo {
      background: #7865ff;
      border-radius: 12px;
      padding: 12px;
      text-align: center;
      font-weight: bold;
      margin-bottom: 25px;
    }
    .channel {
      padding: 12px 5px;
      color: #b8b9ca;
      cursor: pointer;
      border-radius: 8px;
    }
    .channel.active { background: #39364f; color: white; }
    main {
      flex: 1;
      min-width: 0;
      display: flex;
      flex-direction: column;
    }
    header {
      padding: 18px;
      border-bottom: 1px solid #333441;
      font-weight: bold;
    }
    #messages {
      flex: 1;
      overflow-y: auto;
      padding: 18px;
    }
    .message { margin-bottom: 18px; overflow-wrap: anywhere; }
    .username { color: #a99bff; font-weight: bold; }
    form { display: flex; padding: 12px; gap: 8px; }
    input {
      flex: 1;
      min-width: 0;
      padding: 13px;
      background: #292a38;
      color: white;
      border: 1px solid #414253;
      border-radius: 9px;
    }
    button {
      border: 0;
      background: #7865ff;
      color: white;
      padding: 12px;
      border-radius: 9px;
      cursor: pointer;
    }
  </style>
</head>
<body>
  <aside>
    <div class="logo">◉ ORBIT</div>
    <div class="channel active"># general</div>
    <div class="channel"># gaming</div>
    <div class="channel"># memes</div>
  </aside>

  <main>
    <header id="title"># general</header>
    <div id="messages">
      <div class="message">
        <span class="username">Orbit</span>
        <div>Welcome to Orbit! 🚀 Your community starts here.</div>
      </div>
    </div>

    <form id="chatForm">
      <input id="chatInput" placeholder="Message #general..." autocomplete="off">
      <button type="submit">Send</button>
    </form>
  </main>

  <script>
    const form = document.getElementById("chatForm");
    const input = document.getElementById("chatInput");
    const messages = document.getElementById("messages");
    const title = document.getElementById("title");

    form.addEventListener("submit", function(e) {
      e.preventDefault();
      const text = input.value.trim();
      if (!text) return;

      const message = document.createElement("div");
      message.className = "message";

      const username = document.createElement("span");
      username.className = "username";
      username.textContent = "You";

      const content = document.createElement("div");
      content.textContent = text;

      message.append(username, content);
      messages.appendChild(message);
      input.value = "";
      messages.scrollTop = messages.scrollHeight;
    });

    document.querySelectorAll(".channel").forEach(function(channel) {
      channel.addEventListener("click", function() {
        document.querySelectorAll(".channel").forEach(function(c) {
          c.classList.remove("active");
        });
        channel.classList.add("active");
        title.textContent = channel.textContent.trim();
        messages.innerHTML = '<div class="message"><span class="username">Orbit</span><div>Welcome to ' + channel.textContent.trim() + '! 🚀</div></div>';
      });
    });
  </script>
</body>
</html>
